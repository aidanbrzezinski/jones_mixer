(export
	(version "E")
	(design
		(source "/tmp/tmp-kibot-net_sch_print-vwfi2wjv/jones_mixer.kicad_sch")
		(date "Date")
		(tool "Eeschema 10.0.5-unknown-202607221313~667fa36054~ubuntu25.10.1")
		(textvar
			(name "ASSEMBLY_NOTES") "ASSEMBLY NOTES (UNLESS OTHERWISE SPECIFIED)\n\n1)	DO NOT POPULATE PARTS ARE MARKED WITH A RED CROSS.\n\n2)	DO NOT POPULATE PARTS ARE NOT PRESENT IN THE BOM.\n\n3)	IF CONFLICTING INFORMATION IS FOUND BETWEEN THE ASSEMBLY\n	FILE AND BOM, BOM SHOULD BE USED AS THE MAIN SOURCE.\n\n4)	CONFORMAL COATING IS NOT REQUIRED.\n\n5)	DOT IDENTIFIES PIN #1 LOCATION AND DEVICE ORIENTATION\n	WHEN VIEWED FROM THE TOP.")
		(textvar
			(name "BOARD_NAME") "JONES_MIXER")
		(textvar
			(name "BRANCH") "main")
		(textvar
			(name "BUILD_VARIANT") "RELEASED")
		(textvar
			(name "COMPANY") "LTU")
		(textvar
			(name "DESCRIPTION") "Simple Jones Mixer.")
		(textvar
			(name "DESIGNER") "A.B., C.B., A.V.")
		(textvar
			(name "FABRICATION_NOTES") "FABRICATION NOTES (UNLESS OTHERWISE SPECIFIED)\n\n1)	OUTLINE DEFINED IN SEPARATE GERBER FILE WITH\n	\"Edge_Cuts.GBR\" SUFFIX.\n\n	DIMENSIONS OF CIRCUMSIZED RECTANGLE SHOWN ON THIS\n	DRAWING FOR REFERENCE ONLY.\n\n2)	SEE SEPARATE DRILL FILES WITH \".DRL\" SUFFIX \n	FOR HOLE LOCATIONS.\n\n	SELECTED HOLE LOCATIONS SHOWN ON THIS DRAWING \n	FOR REFERENCE ONLY.\n\n3)	SURFACE FINISH: IMMERSION GOLD\n\n4)	SOLDERMASK ON BOTH SIDES OF THE BOARD SHALL \n	BE LPI, COLOR BLUE.\n\n5)	SILK SCREEN LEGEND TO BE APPLIED PER LAYER \n	STACKUP USING WHITE.\n\n6)	ALL VIAS ARE TENTED ON BOTH SIDES UNLESS \n	SOLDERMASK OPENED IN GERBER.\n\n\n7)	DESIGN GEOMETRY MINIMUM FEATURE SIZES:\n\n	BOARD SIZE				32.000 × 32.000 mm\n	BOARD THICKNESS		1.581 mm\n	TRACE WIDTH			0.300 mm\n	TRACE TO TRACE		0.300 mm\n	MIN. HOLE (PTH)			0.250 mm\n	MIN. HOLE (NPTH)		N/A mm\n	ANNULAR RING			0.150 mm\n	COPPER TO HOLE		0.254 mm\n	COPPER TO EDGE		0.500 mm\n	HOLE TO HOLE			0.254 mm")
		(textvar
			(name "GIT_HASH_PCB") "9e800e4")
		(textvar
			(name "GIT_HASH_SCH") "9e800e4")
		(textvar
