# KiBot preflight for setting Text Variables
# https://kibot.readthedocs.io/en/latest/configuration/preflights/set_text_variables.html

kibot:
  version: 1

preflight:
  update_xml: true
  set_text_variables:

    # Git related information
    - variable: 'REVISION'
      # command: 'git describe --tags --abbrev=0 || echo ""'
      text: '+ (Unreleased)'
    - variable: 'RELEASE_DATE'
      command: 'git log -1 --format="%ad" --date="format:%d-%b-%Y"'
    - variable: 'RELEASE_DATE_NUM'
      command: 'git log -1 --format="%ad" --date=short'
    - variable: 'GIT_HASH_SCH'
      command: 'git log -1 --format="%h" $KIBOT_SCH_NAME'
    - variable: 'GIT_HASH_PCB'
      command: 'git log -1 --format="%h" $KIBOT_PCB_NAME'
    - variable: 'GIT_URL'
      text: 'https://github.com/aidanbrzezinski/jones_mixer'
    - variable: 'BRANCH'
      # For the CI badge URL in README.md (badge.svg?branch=<name>) — an
      # empty/missing branch there makes GitHub show "no status" regardless
      # of how the run actually went. ci.yaml passes the real branch (or
      # `main` for a tag push) via -E BRANCH=...
      text: 'dev'

    # Metadata. Double-quoted, not single-quoted like everything else in this
    # file: these five are free-text fields a human types into configure.py
    # (title, description, company, designer name), and a single-quoted YAML
    # scalar is terminated by the FIRST unescaped apostrophe it contains. Any
    # value with a plain apostrophe in it ("the car's electrical
    # architecture") broke this with "expected <block end>, but found
    # <scalar>" — confirmed against a real failed run. Double quotes don't
    # have that problem for apostrophes; only a literal `"` or `\` in the
    # text would still break it, which is far less likely to occur.
    - variable: 'PROJECT_NAME'
      text: "Jones Mixer"
    - variable: 'BOARD_NAME'
      text: "JONES_MIXER"
    - variable: 'DESCRIPTION'
      text: "Simple Jones Mixer."
    - variable: 'COMPANY'
      text: "LTU"
    - variable: 'DESIGNER'
      text: "Aidan Brzezinski, Chloe LaBell, Andres Vega"
    # Named BUILD_VARIANT, not VARIANT: KiCad 10 reserves `${VARIANT}` for its
    # own native BOM/schematic variant feature (unrelated to KiBot's DRAFT/
    # PRELIMINARY/CHECKED/RELEASED variants below). A project text_variable
    # literally named VARIANT gets silently shadowed by that built-in and
    # renders blank — confirmed empirically: renaming it to BUILD_VARIANT is
    # what actually makes the value show up on rendered documents.
    - variable: 'BUILD_VARIANT'
      text: '%V'

    # Revision History sheet: one slot per column, filled from CHANGELOG.md's
    # released sections, newest first (1 = latest release, 2 = the one before,
    # ...). Nothing to edit per release. A slot with no release yet comes out
    # empty. To show more releases, add slot 5, 6... here AND matching
    # ${RELEASE_TITLE_n}/${RELEASE_BODY_n} text boxes on Revision History.kicad_sch.
    - variable: 'RELEASE_TITLE_1'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --title-only --index 1'
    - variable: 'RELEASE_BODY_1'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --extra-spaces --separators 35 --index 1'
    - variable: 'RELEASE_TITLE_2'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --title-only --index 2'
    - variable: 'RELEASE_BODY_2'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --extra-spaces --separators 35 --index 2'
    - variable: 'RELEASE_TITLE_3'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --title-only --index 3'
    - variable: 'RELEASE_BODY_3'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --extra-spaces --separators 35 --index 3'
    - variable: 'RELEASE_TITLE_4'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --title-only --index 4'
    - variable: 'RELEASE_BODY_4'
      command: 'python3 kibot_resources/scripts/get_changelog.py -f CHANGELOG.md --extra-spaces --separators 35 --index 4'

    # Fabrication notes
    - variable: 'FABRICATION_NOTES'
      expand_in_command: true
      command: '[ -f "Manufacturing/Fabrication/%f-fabrication_notes%v.txt" ] && cat "Manufacturing/Fabrication/%f-fabrication_notes%v.txt" || echo ""'


    # Fabrication notes
    - variable: 'ASSEMBLY_NOTES'
      expand_in_command: true
      command: '[ -f "Manufacturing/Assembly/%f-assembly_notes%v.txt" ] && cat "Manufacturing/Assembly/%f-assembly_notes%v.txt" || echo ""'

    # Page titles for automatic ToC
    - variable: 'SHEET_NAME_1'
      text: 'Cover Page'
    - variable: 'SHEET_NAME_2'
      command: 'python3 kibot_resources/scripts/get_sheet_title.py -f "${KIBOT_SCH_NAME%.kicad_sch}.xml" --dots-number 38 -p 2'
    - variable: 'SHEET_NAME_3'
      command: 'python3 kibot_resources/scripts/get_sheet_title.py -f "${KIBOT_SCH_NAME%.kicad_sch}.xml" --dots-number 38 -p 3'
